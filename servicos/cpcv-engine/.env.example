# Copiar para .env.local e preencher com os valores do projecto Supabase do cliente.
# Nunca comitar .env.local - já está no .gitignore.

# Supabase - um projecto por cliente, não reutilizar entre projectos.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Password para entrar na app (qualquer valor à escolha)
DASHBOARD_PASSWORD=

# Valor fixo usado internamente para assinar o cookie de sessão (qualquer string à escolha)
AUTH_SECRET=

# Claude API - só necessário se a secção /cpcv (CPCV com IA) estiver activa neste projecto.
ANTHROPIC_API_KEY=

# Código de arranque para criar a primeira conta admin em /cpcv/registo (qualquer valor à
# escolha). É estático e reutilizável de propósito - serve para o primeiro admin, ou para
# criar outro mais tarde por quem tiver acesso a estas env vars (ex.: no Vercel). Todos os
# outros convites (agente/gestora) passam a gerar-se dentro da app, por quem já tem conta de
# gestora ou admin (ver tabela cpcv_convites, migration_fase6.sql) - não há mais nenhum
# código fixo partilhado depois deste.
CPCV_INVITE_ADMIN=

# O nome da mediadora e a licença AMI são fixos no código (lib/cpcv-clausulas.ts, AGENCIA_NOME/
# AGENCIA_AMI) - decisão do cliente, iguais em todos os contratos. Aqui ficam só os dados
# bancários (não devem estar num repositório público): conta da agência, usada na Cláusula de
# Preço e Condições de Pagamento quando um processo tem destino_sinal = "agencia" (o sinal fica
# com a agência como fiel depositária - ver app/cpcv/[id]/CondicoesNegocio.tsx). Fixos por
# deployment, nunca escritos à mão por processo.
CPCV_AGENCIA_IBAN=
CPCV_AGENCIA_BANCO=
# Email da agência proposto por omissão no campo "email para comunicar o resultado da avaliação
# bancária" (Cláusula de Avaliação Bancária) - o agente pode alterá-lo por processo.
CPCV_AGENCIA_EMAIL=

# Cópia automática do CPCV aprovado numa pasta do Google Drive - opcional, sem estas
# variáveis a app funciona na mesma, só sem essa cópia (ver lib/google-drive.ts e
# scripts/obter-refresh-token-google.mjs para as obter).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Opcional - ID da pasta-mãe no Drive onde as pastas de cada processo são criadas.
# Sem isto, ficam na raiz ("O meu Drive") da conta ligada.
GOOGLE_DRIVE_ROOT_FOLDER_ID=
