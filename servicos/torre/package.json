{
  "name": "torre",
  "version": "0.1.0",
  "private": true,
  "description": "Torre: painel de gestão interno da Ace Labs (contas, movimentos, débitos diretos, sócios). Só para os sócios.",
  "scripts": {
    "predev": "node scripts/copiar-worker.mjs",
    "dev": "next dev -p 3003",
    "prebuild": "node scripts/copiar-worker.mjs",
    "build": "next build",
    "start": "next start -p 3003",
    "lint": "next lint",
    "testar": "tsx testes/correr.ts",
    "socio": "tsx --env-file=.env.local scripts/criar-socio.ts",
    "schema": "tsx --env-file=.env.local scripts/aplicar-schema.ts",
    "copia": "tsx --env-file=.env.local scripts/copia.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.106.2",
    "jsqr": "^1.4.0",
    "jszip": "^3.10.2",
    "next": "14.2.35",
    "pdfjs-dist": "^4.10.38",
    "react": "^18",
    "react-dom": "^18",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "^8.11.10",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "pg": "^8.13.1",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
